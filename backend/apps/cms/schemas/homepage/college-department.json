{
  "manifest_version": 1,
  "id": "college-department",
  "version": 4,
  "name": "College/Department",
  "description": "A responsive college or department homepage with split-image carousels, highlights, campus panels, published news, partnerships and enquiries. Select this Site's images before applying.",
  "required_modules": [
    "PAGES",
    "VISUAL_BUILDER"
  ],
  "media_slots": [
    {
      "code": "hero",
      "label": "Hero photograph",
      "node_ids": [
        "college-hero-learn",
        "college-hero-research"
      ]
    },
    {
      "code": "campus",
      "label": "Campus photograph",
      "node_ids": [
        "college-campus-life",
        "college-campus-research"
      ]
    }
  ],
  "layout": {
    "schema_version": 1,
    "settings": {
      "show_title": false,
      "content_width": "full"
    },
    "rows": [
      {
        "id": "college-hero",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-hero-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-hero-carousel",
                "type": "layout_slider",
                "props": {
                  "items": [
                    {
                      "id": "college-hero-learn-slide",
                      "children": [
                        {
                          "id": "college-hero-learn",
                          "type": "hero_image",
                          "props": {
                            "asset_id": "00000000-0000-0000-0000-000000000000",
                            "alt": "Choose an approved Site photograph",
                            "title": "Ideas that shape a better future",
                            "text": "Discover learning, research and a community committed to public service.",
                            "layout": "split",
                            "height": "medium",
                            "mask": "curve",
                            "actions": [
                              {
                                "id": "college-hero-learn-action",
                                "label": "Explore opportunities",
                                "href": "#opportunities"
                              }
                            ]
                          },
                          "style": {
                            "background": "navy",
                            "text_color": "inverse"
                          }
                        }
                      ]
                    },
                    {
                      "id": "college-hero-research-slide",
                      "children": [
                        {
                          "id": "college-hero-research",
                          "type": "hero_image",
                          "props": {
                            "asset_id": "00000000-0000-0000-0000-000000000000",
                            "alt": "Choose an approved Site photograph",
                            "title": "Discover. Collaborate. Make an impact.",
                            "text": "Connect with our academic community and explore our work.",
                            "layout": "split",
                            "height": "medium",
                            "mask": "curve",
                            "actions": [
                              {
                                "id": "college-hero-research-action",
                                "label": "Explore opportunities",
                                "href": "#research"
                              }
                            ]
                          },
                          "style": {
                            "background": "navy",
                            "text_color": "inverse"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "full",
          "padding": "none",
          "gap": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-impact-title",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-impact-title-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-impact-heading",
                "type": "headline",
                "props": {
                  "text": "Learning with purpose",
                  "level": 2
                }
              },
              {
                "id": "college-impact-intro",
                "type": "editor",
                "props": {
                  "html": "<p>Education, discovery and service connect our community.</p>"
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-impact",
        "type": "section",
        "ratios": [
          1,
          1,
          1
        ],
        "columns": [
          {
            "id": "college-impact-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-learn-icon",
                "type": "icon",
                "props": {
                  "icon": "school",
                  "label": "Education"
                }
              },
              {
                "id": "college-learn-title",
                "type": "headline",
                "props": {
                  "text": "Learn",
                  "level": 2
                }
              },
              {
                "id": "college-learn-text",
                "type": "editor",
                "props": {
                  "html": "<p>Explore academic pathways and develop practical knowledge.</p>"
                }
              }
            ]
          },
          {
            "id": "college-impact-column-1",
            "type": "column",
            "children": [
              {
                "id": "college-research-icon",
                "type": "icon",
                "props": {
                  "icon": "book",
                  "label": "Research"
                }
              },
              {
                "id": "college-research-title",
                "type": "headline",
                "props": {
                  "text": "Discover",
                  "level": 2
                }
              },
              {
                "id": "college-research-text",
                "type": "editor",
                "props": {
                  "html": "<p>Connect ideas and collaborate on meaningful research.</p>"
                }
              }
            ]
          },
          {
            "id": "college-impact-column-2",
            "type": "column",
            "children": [
              {
                "id": "college-community-icon",
                "type": "icon",
                "props": {
                  "icon": "location",
                  "label": "Community"
                }
              },
              {
                "id": "college-community-title",
                "type": "headline",
                "props": {
                  "text": "Connect",
                  "level": 2
                }
              },
              {
                "id": "college-community-text",
                "type": "editor",
                "props": {
                  "html": "<p>Work together to serve our university and wider community.</p>"
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg",
          "background": "mist",
          "radius": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-quick",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-quick-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-quick-anchor",
                "type": "menu_anchor",
                "props": {
                  "anchor": "opportunities"
                }
              },
              {
                "id": "college-quick-title",
                "type": "headline",
                "props": {
                  "text": "Explore your opportunities",
                  "level": 2
                }
              },
              {
                "id": "college-quick-links",
                "type": "button_grid",
                "props": {
                  "items": [
                    {
                      "id": "college-quick-news",
                      "label": "Latest news",
                      "href": "/posts"
                    },
                    {
                      "id": "college-quick-life",
                      "label": "Campus life",
                      "href": "#campus-life"
                    },
                    {
                      "id": "college-quick-research",
                      "label": "Research",
                      "href": "#research"
                    },
                    {
                      "id": "college-quick-contact",
                      "label": "Contact",
                      "href": "#contact"
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-campus",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-campus-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-campus-anchor",
                "type": "menu_anchor",
                "props": {
                  "anchor": "campus-life"
                }
              },
              {
                "id": "college-campus-carousel",
                "type": "layout_slider",
                "props": {
                  "items": [
                    {
                      "id": "college-campus-life-slide",
                      "children": [
                        {
                          "id": "college-campus-life",
                          "type": "hero_image",
                          "props": {
                            "asset_id": "00000000-0000-0000-0000-000000000000",
                            "alt": "Choose an approved Site photograph",
                            "title": "A place to belong",
                            "text": "Explore student life, academic facilities and opportunities to connect.",
                            "layout": "split",
                            "height": "medium",
                            "mask": "curve",
                            "actions": [
                              {
                                "id": "college-campus-life-action",
                                "label": "Explore opportunities",
                                "href": "#contact"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    {
                      "id": "college-campus-research-slide",
                      "children": [
                        {
                          "id": "college-campus-research",
                          "type": "hero_image",
                          "props": {
                            "asset_id": "00000000-0000-0000-0000-000000000000",
                            "alt": "Choose an approved Site photograph",
                            "title": "Knowledge in action",
                            "text": "Meet the people and projects shaping our community.",
                            "layout": "split_reverse",
                            "height": "medium",
                            "mask": "curve",
                            "actions": [
                              {
                                "id": "college-campus-research-action",
                                "label": "Explore opportunities",
                                "href": "#research"
                              }
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "full",
          "padding": "none",
          "gap": "lg",
          "background": "mist"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-news",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-news-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-news-title",
                "type": "headline",
                "props": {
                  "text": "Latest news",
                  "level": 2
                }
              },
              {
                "id": "college-news-intro",
                "type": "editor",
                "props": {
                  "html": "<p>Updates from this Site, published by our editorial team.</p>"
                }
              },
              {
                "id": "college-news-grid",
                "type": "loop_grid",
                "props": {
                  "source": "posts",
                  "limit": 4,
                  "presentation": "featured"
                }
              },
              {
                "id": "college-news-more",
                "type": "button",
                "props": {
                  "label": "View all news",
                  "href": "/posts",
                  "variant": "outline"
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-research",
        "type": "section",
        "ratios": [
          60,
          40
        ],
        "columns": [
          {
            "id": "college-research-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-research-anchor",
                "type": "menu_anchor",
                "props": {
                  "anchor": "research"
                }
              },
              {
                "id": "college-research-heading",
                "type": "headline",
                "props": {
                  "text": "Research and collaboration",
                  "level": 2
                }
              },
              {
                "id": "college-research-intro",
                "type": "editor",
                "props": {
                  "html": "<p>Explore our research priorities and find opportunities to work together.</p>"
                }
              }
            ]
          },
          {
            "id": "college-research-column-1",
            "type": "column",
            "children": [
              {
                "id": "college-facilities",
                "type": "tabs",
                "props": {
                  "items": [
                    {
                      "id": "college-tab-programs",
                      "title": "Academic programs",
                      "text": "Use this space to describe approved academic pathways and entry information."
                    },
                    {
                      "id": "college-tab-facilities",
                      "title": "Facilities",
                      "text": "Describe your Site facilities, libraries and learning spaces."
                    },
                    {
                      "id": "college-tab-support",
                      "title": "Student support",
                      "text": "Describe the support available to students and the community."
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg",
          "background": "mist",
          "radius": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-partners",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "college-partners-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-partners-title",
                "type": "headline",
                "props": {
                  "text": "Partnership and collaboration",
                  "level": 2
                }
              },
              {
                "id": "college-partners-carousel",
                "type": "anything_carousel",
                "props": {
                  "items": [
                    {
                      "id": "college-partner-academic",
                      "children": [
                        {
                          "id": "college-partner-academic-title",
                          "type": "headline",
                          "props": {
                            "text": "Academic collaboration",
                            "level": 2
                          }
                        },
                        {
                          "id": "college-partner-academic-text",
                          "type": "editor",
                          "props": {
                            "html": "<p>Replace this introduction with approved partner information and links.</p>"
                          }
                        },
                        {
                          "id": "college-partner-academic-link",
                          "type": "button",
                          "props": {
                            "label": "Discuss a partnership",
                            "href": "#contact",
                            "variant": "outline"
                          }
                        }
                      ]
                    },
                    {
                      "id": "college-partner-community",
                      "children": [
                        {
                          "id": "college-partner-community-title",
                          "type": "headline",
                          "props": {
                            "text": "Community partnerships",
                            "level": 2
                          }
                        },
                        {
                          "id": "college-partner-community-text",
                          "type": "editor",
                          "props": {
                            "html": "<p>Share the work your Site undertakes with its community.</p>"
                          }
                        },
                        {
                          "id": "college-partner-community-link",
                          "type": "button",
                          "props": {
                            "label": "Contact our team",
                            "href": "#contact",
                            "variant": "outline"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg",
          "background": "mist",
          "radius": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      },
      {
        "id": "college-contact",
        "type": "section",
        "ratios": [
          40,
          60
        ],
        "columns": [
          {
            "id": "college-contact-column-0",
            "type": "column",
            "children": [
              {
                "id": "college-contact-anchor",
                "type": "menu_anchor",
                "props": {
                  "anchor": "contact"
                }
              },
              {
                "id": "college-contact-heading",
                "type": "headline",
                "props": {
                  "text": "Start a conversation",
                  "level": 2
                }
              },
              {
                "id": "college-contact-copy",
                "type": "editor",
                "props": {
                  "html": "<p>Send an enquiry to our Site team.</p>"
                }
              }
            ]
          },
          {
            "id": "college-contact-column-1",
            "type": "column",
            "children": [
              {
                "id": "college-contact-form",
                "type": "contact_form",
                "props": {
                  "form_code": "homepage-enquiries",
                  "submit_label": "Send enquiry"
                }
              }
            ]
          }
        ],
        "style": {
          "content_width": "wide",
          "padding": "lg",
          "gap": "lg"
        },
        "responsive": {
          "mobile": {
            "stack": true,
            "gap": "md"
          }
        }
      }
    ]
  }
}
