{
  "manifest_version": 1,
  "id": "college-department",
  "version": 3,
  "name": "College/Department",
  "description": "A focused academic Site homepage with live identity, local navigation, programme links and published news.",
  "required_modules": [
    "PAGES",
    "VISUAL_BUILDER"
  ],
  "layout": {
    "schema_version": 1,
    "settings": {
      "show_title": false,
      "content_width": "wide"
    },
    "rows": [
      {
        "id": "cd-brand",
        "type": "section",
        "ratios": [
          25,
          75
        ],
        "columns": [
          {
            "id": "cd-brand-logo",
            "type": "column",
            "children": [
              {
                "id": "cd-logo",
                "type": "site_logo",
                "props": {}
              }
            ]
          },
          {
            "id": "cd-brand-title",
            "type": "column",
            "children": [
              {
                "id": "cd-title",
                "type": "site_title",
                "props": {}
              }
            ]
          }
        ],
        "style": {
          "padding": "md",
          "background": "paper",
          "text_color": "default",
          "gap": "md",
          "radius": "md"
        },
        "responsive": {
          "mobile": {
            "stack": true
          }
        }
      },
      {
        "id": "cd-nav",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "cd-nav-col",
            "type": "column",
            "children": [
              {
                "id": "cd-menu",
                "type": "menu",
                "props": {
                  "menu_code": "header"
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "sm",
          "background": "mist",
          "text_color": "default",
          "gap": "sm"
        }
      },
      {
        "id": "cd-hero",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "cd-hero-col",
            "type": "column",
            "children": [
              {
                "id": "cd-hero-title",
                "type": "headline",
                "props": {
                  "text": "Welcome to our academic community",
                  "level": 2
                }
              },
              {
                "id": "cd-hero-copy",
                "type": "editor",
                "props": {
                  "html": "<p>Replace this introduction with approved information about your college or department. Add locally approved imagery through the builder when available.</p>"
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "xl",
          "background": "blue_gradient",
          "text_color": "inverse",
          "radius": "lg",
          "gap": "lg",
          "text_size": "xl"
        },
        "responsive": {
          "mobile": {
            "gap": "md"
          }
        }
      },
      {
        "id": "cd-links",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "cd-links-col",
            "type": "column",
            "children": [
              {
                "id": "cd-links-title",
                "type": "headline",
                "props": {
                  "text": "Explore our community",
                  "level": 3
                }
              },
              {
                "id": "cd-hero-links",
                "type": "button_grid",
                "props": {
                  "items": [
                    {
                      "id": "cd-programmes",
                      "label": "Programmes",
                      "href": "/programmes"
                    },
                    {
                      "id": "cd-admissions",
                      "label": "Admissions",
                      "href": "/admissions"
                    },
                    {
                      "id": "cd-contact",
                      "label": "Contact our team",
                      "href": "/contact"
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "lg",
          "background": "paper",
          "text_color": "default",
          "radius": "md",
          "gap": "md"
        }
      },
      {
        "id": "cd-news",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "cd-news-col",
            "type": "column",
            "children": [
              {
                "id": "cd-news-title",
                "type": "headline",
                "props": {
                  "text": "College and department news",
                  "level": 3
                }
              },
              {
                "id": "cd-news-grid",
                "type": "loop_grid",
                "props": {
                  "source": "posts",
                  "limit": 3
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "lg",
          "background": "paper",
          "text_color": "default",
          "radius": "md",
          "gap": "md"
        }
      }
    ]
  }
}
