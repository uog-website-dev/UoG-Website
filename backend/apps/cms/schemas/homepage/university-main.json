{
  "manifest_version": 1,
  "id": "university-main",
  "version": 3,
  "name": "University Main",
  "description": "A branded university homepage with an editable welcome, key links and published Site news.",
  "required_modules": [
    "PAGES",
    "VISUAL_BUILDER"
  ],
  "layout": {
    "schema_version": 1,
    "settings": {
      "show_title": false,
      "content_width": "wide"
    },
    "rows": [
      {
        "id": "um-brand",
        "type": "section",
        "ratios": [
          25,
          75
        ],
        "columns": [
          {
            "id": "um-brand-logo",
            "type": "column",
            "children": [
              {
                "id": "um-logo",
                "type": "site_logo",
                "props": {}
              }
            ]
          },
          {
            "id": "um-brand-title",
            "type": "column",
            "children": [
              {
                "id": "um-title",
                "type": "site_title",
                "props": {}
              }
            ]
          }
        ],
        "style": {
          "padding": "md",
          "background": "paper",
          "text_color": "default",
          "gap": "md",
          "radius": "md"
        },
        "responsive": {
          "mobile": {
            "stack": true
          }
        }
      },
      {
        "id": "um-nav",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "um-nav-col",
            "type": "column",
            "children": [
              {
                "id": "um-menu",
                "type": "menu",
                "props": {
                  "menu_code": "header"
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "sm",
          "background": "mist",
          "text_color": "default",
          "gap": "sm"
        }
      },
      {
        "id": "um-hero",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "um-hero-col",
            "type": "column",
            "children": [
              {
                "id": "um-hero-title",
                "type": "headline",
                "props": {
                  "text": "Welcome to our university",
                  "level": 2
                }
              },
              {
                "id": "um-hero-copy",
                "type": "editor",
                "props": {
                  "html": "<p>Replace this introduction with an approved welcome for your Site. Add locally approved imagery through the builder when available.</p>"
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "xl",
          "background": "navy_gradient",
          "text_color": "inverse",
          "radius": "lg",
          "gap": "lg",
          "text_size": "xl"
        },
        "responsive": {
          "mobile": {
            "gap": "md"
          }
        }
      },
      {
        "id": "um-links",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "um-links-col",
            "type": "column",
            "children": [
              {
                "id": "um-links-title",
                "type": "headline",
                "props": {
                  "text": "Explore our university",
                  "level": 3
                }
              },
              {
                "id": "um-hero-links",
                "type": "button_grid",
                "props": {
                  "items": [
                    {
                      "id": "um-apply",
                      "label": "Apply to study",
                      "href": "/admissions"
                    },
                    {
                      "id": "um-programmes",
                      "label": "Explore programmes",
                      "href": "/academics"
                    },
                    {
                      "id": "um-research",
                      "label": "Research",
                      "href": "/research"
                    }
                  ]
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "lg",
          "background": "paper",
          "text_color": "default",
          "radius": "md",
          "gap": "md"
        }
      },
      {
        "id": "um-news",
        "type": "section",
        "ratios": [
          100
        ],
        "columns": [
          {
            "id": "um-news-col",
            "type": "column",
            "children": [
              {
                "id": "um-news-title",
                "type": "headline",
                "props": {
                  "text": "University news",
                  "level": 3
                }
              },
              {
                "id": "um-news-grid",
                "type": "loop_grid",
                "props": {
                  "source": "posts",
                  "limit": 3
                }
              }
            ]
          }
        ],
        "style": {
          "padding": "lg",
          "background": "paper",
          "text_color": "default",
          "radius": "md",
          "gap": "md"
        }
      }
    ]
  }
}
