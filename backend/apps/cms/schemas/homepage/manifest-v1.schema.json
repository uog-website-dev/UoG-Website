{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uog:homepage-template:1",
  "title": "Approved homepage starting template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "name",
    "description",
    "required_modules",
    "layout"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "required_modules": {
      "const": [
        "PAGES",
        "VISUAL_BUILDER"
      ]
    },
    "layout": {
      "$ref": "../layout/layout-v1.schema.json"
    },
    "media_slots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label",
          "node_ids"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
