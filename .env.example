# =============================================================================
# UoG Digital Platform — development environment variables
#
#   cp .env.example .env
#
# Every value below has a development default; docker compose works without
# any edits for local development. Replace the passwords/secrets before any
# shared or production-like deployment. `.env` is gitignored — never commit
# real credentials.
# =============================================================================

# ---- General ---------------------------------------------------------------
DEBUG=True
# Local Compose only: grant a DB-backed platform-admin assignment to this
# exact development username on first authenticated API request. Ignored when
# DEBUG=False. Never set for shared or production deployments.
DEV_PLATFORM_ADMIN_BOOTSTRAP=True
DEV_PLATFORM_ADMIN_USERNAME=devuser
# Explicit opt-in; signed platform-admin tokens are still required. Ignored when DEBUG=False.
ORGANIZATIONS_DEV_WRITES_ENABLED=False
LOG_LEVEL=INFO

# ---- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# ---- Django API: OIDC access-token validation (Keycloak) -------------------
# The API is a resource server: it validates the access tokens the frontends
# obtain at sign-in. The issuer is the PUBLIC address Keycloak stamps into
# tokens; the JWKS URL may use the Docker network name.
OIDC_ISSUER=http://localhost:8080/realms/uog
OIDC_JWKS_URL=http://keycloak:8080/realms/uog/protocol/openid-connect/certs
OIDC_AUDIENCE=backend-api
# API docs default to DEBUG: public in dev, disabled when DEBUG=False.
# When explicitly enabled with DEBUG=False, active staff authentication is required.
# API_DOCS_ENABLED=False
OIDC_ALLOWED_CLIENTS=public-web,admin-web,backend-api
OIDC_STAFF_ROLES=platform-admin

# ---- PostgreSQL (shared application database) ------------------------------
POSTGRES_USER=uog_admin
POSTGRES_PASSWORD=uog_admin_password
DB_NAME=uog_db
# Runtime role (least privilege) and migration role (owns schema):
DB_USER=uog_app
DB_PASSWORD=uog_app_password
DB_MIGRATE_USER=uog_migrate
DB_MIGRATE_PASSWORD=uog_migrate_password
POSTGRES_PORT=5432

# ---- Redis cache -----------------------------------------------------------
CACHE_KEY_PREFIX=uog

# (Celery broker URLs are set in docker-compose.yml: redis://redis-broker:6379)

# ---- MinIO object storage --------------------------------------------------
MINIO_ROOT_USER=uog_minio_admin
MINIO_ROOT_PASSWORD=minio_dev_secret_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Keycloak --------------------------------------------------------------
KEYCLOAK_PORT=8080
KC_ADMIN_USERNAME=uog_admin
KC_ADMIN_PASSWORD=keycloak_admin_dev_password
KC_DB_USER=keycloak
KC_DB_PASSWORD=keycloak_db_dev_password
KC_DB_NAME=keycloak

# OIDC client secrets (applied to the imported realm by keycloak-init)
KEYCLOAK_PUBLIC_WEB_SECRET=public-web-dev-secret
KEYCLOAK_ADMIN_WEB_SECRET=admin-web-dev-secret
KEYCLOAK_BACKEND_API_SECRET=backend-api-dev-secret

# Development smoke-test user (created by keycloak-init)
KEYCLOAK_DEV_USERNAME=devuser
KEYCLOAK_DEV_PASSWORD=DevUser!2026

# ---- Frontend auth (Auth.js / NextAuth v5) ---------------------------------
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
# Server-side Django API base URL (Docker network) used by admin-web when it
# calls protected endpoints with the session's Keycloak access token.
API_BASE_URL=http://backend:8000/api

# ---- Service ports (host side) ---------------------------------------------
NGINX_PORT=80
BACKEND_PORT=8000
PUBLIC_WEB_PORT=3000
ADMIN_WEB_PORT=3001
