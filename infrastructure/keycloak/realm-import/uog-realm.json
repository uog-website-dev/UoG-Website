{
  "realm": "uog",
  "enabled": true,
  "displayName": "University of Gondar",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Full administrative access to the platform (organizations, sites, content)."
      },
      {
        "name": "platform-editor",
        "description": "May create and publish content, but not manage organizations or sites."
      },
      {
        "name": "platform-viewer",
        "description": "Read-only access to the administration console."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "uog-api",
      "description": "Scopes every access token in this realm carries so the platform API can validate it: the audience it was issued for and the stable subject identifier.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "uog-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backend-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "uog-api-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "public-web",
      "name": "UoG Public Website",
      "description": "Auth.js (NextAuth v5) client for the Next.js public frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/*",
        "http://localhost/api/auth/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*+http://localhost/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "email", "roles", "uog-api"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "admin-web",
      "name": "UoG Admin Console",
      "description": "Auth.js (NextAuth v5) client for the Next.js admin frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/admin/api/auth/*",
        "http://localhost/admin/api/auth/*"
      ],
      "webOrigins": ["http://localhost:3001", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/admin/*+http://localhost/admin/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "email", "roles", "uog-api"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "backend-api",
      "name": "UoG Backend API",
      "description": "Server-to-server client (client credentials + direct grants for development smoke tests)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {},
      "defaultClientScopes": ["web-origins", "acr", "profile", "email", "roles", "uog-api"],
      "optionalClientScopes": ["offline_access"]
    }
  ]
}
