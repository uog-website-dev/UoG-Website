# Normalise line endings: shell scripts, configs and sources must be LF so
# that Linux containers can execute/mount them regardless of the developer's
# OS or git.autocrlf setting.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

Dockerfile text eol=lf
