# Top-level .editorconfig for the UoG Digital Platform monorepo
# https://editorconfig.org

root = true

[*.md]
max_line_length = 100
trim_trailing_whitespace = true
insert_final_newline = true

[python]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8

[*.{js,jsx,ts,tsx,json,css,scss,less,html,md}]
indent_style = space
indent_size = 2
insert_final_newline = true
charset = utf-8

[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
root = true